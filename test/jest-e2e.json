{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "maxWorkers": 1,
  "testRegex": ".e2e-spec.ts$",
  "globalSetup": "<rootDir>/e2e-global-setup.ts",
  "setupFiles": [
    "<rootDir>/e2e-env.ts"
  ],
  "setupFilesAfterEnv": [
    "<rootDir>/reset-db.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
