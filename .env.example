# ShowUp backend — environment variables.
# Copy to `.env` for local development. NEVER commit real secrets.
# Each environment (local | development | staging | production) gets its own values.

# ─────────────── Application ───────────────
NODE_ENV=local
PORT=3000
APP_NAME=showup-backend
# Comma-separated list of allowed CORS origins, or * for all (local only).
CORS_ORIGINS=*

# ─────────────── Database (PostgreSQL + PostGIS) ───────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=showup
DB_PASSWORD=showup
DB_NAME=showup
# Enable TLS for managed/staging/production databases.
DB_SSL=false
# Run pending migrations automatically on boot (handy in dev; prefer explicit in prod).
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

# ─────────────── Redis (BullMQ — Epic 17, not yet wired) ───────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────── API docs (Swagger / OpenAPI) ───────────────
# Enabled in local/development. In staging, set SWAGGER_USER/PASSWORD to require basic auth.
# Set SWAGGER_ENABLED=false in production.
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_USER=
SWAGGER_PASSWORD=

# ─────────────── RevenueCat (payments — Epic 9) ───────────────
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# ─────────────── Firebase Cloud Messaging (push — Epic 10) ───────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─────────────── PostHog EU (analytics — Epic 11) ───────────────
POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ─────────────── Sentry (observability — Epic 16) ───────────────
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# ─────────────── CMS (remote content — Epic 13) ───────────────
CMS_BASE_URL=
CMS_API_KEY=

# ─────────────── Auth & tokens (Epic 2) ───────────────
# REQUIRED: secret used to sign access JWTs (min 16 chars). Use a long random value per environment.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_LENGTH=4
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
# Returns the OTP in the API response for testing. Defaults on outside production; force off with false.
AUTH_EXPOSE_OTP=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# ─────────────── Social login (Epic 2) ───────────────
# Comma-separated client/app/service IDs to accept. Leave empty to disable that provider.
# Google: the OAuth client IDs (iOS, Android, Web) issued in Google Cloud Console.
GOOGLE_CLIENT_IDS=
# Apple: the app bundle IDs / Services IDs that appear as the token `aud`.
APPLE_CLIENT_IDS=
APPLE_ISSUER=https://appleid.apple.com
