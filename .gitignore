# Dependencies
/node_modules

# Build output
/dist
/build

# Uploaded media (local-disk dev storage)
/uploads

# Test coverage
/coverage

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & secrets — never commit real values
.env
.env.*
!.env.example

# Master backlog / planning material (local-only)
docs/planning/esma_1.docx
*.docx

# TypeScript build info
*.tsbuildinfo

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Claude Code transient runtime files (keep settings.json, drop locks)
.claude/scheduled_tasks.lock
.claude/*.lock

# Python bytecode from the preview generators
__pycache__/
*.pyc

# rendered by audit/render-flags.py
mobile/welcome-screen/audit/flags.html

# Word copies of the docs, regenerated by scripts/md-to-docx.py.
# The Markdown is the source; a committed binary would churn on every edit.
docs/*.docx

# Design-handoff spec-sheet PNG exports — deliberately NOT versioned
#
# `design_handoff_showup/` is the design source of truth and IS committed: the reference .jsx
# files, the tokens, the tracking registry, the tickets and the renderable .html spec sheets.
# The 18 PNG exports beside those .html files are not. They are ~76 MB of generated binary, git
# keeps every version of a binary forever, and the tickets' own order of authority ends
# "PNG wins on nothing" — the .jsx is what any number is read from.
#
# They live on the Jira tickets, which is where they are looked at. If we ever need those exact
# bitmaps versioned, that is a job for Git LFS or an artifact store, not for this repo's history.
#
# Decision: 25 September 2026, on adding the handoff from "Show Up Design System (2).zip".
design_handoff_showup/**/spec-sheets/*.png
