          "allowed_values": "none | pending | verified | rejected",
          "class": "3",
          "why": "Replaces boolean photo_verified. Note: the provider is a stand-in that always returns pass."
        },
        {
          "property": "profile_visible",
          "type": "Boolean",
          "scope": "User Property",
          "allowed_values": "true | false",
          "class": "0",
          "why": "The one privacy switch that actually exists."
        },
        {
          "property": "topic_id",
          "type": "String (Enum)",
          "scope": "Event Property",
          "allowed_values": "See prompt_topic_id registry (enums §17)",
          "class": "0",
          "why": "Which prompt topic. The whole point of the prompts taxonomy: it is what answers “which topics do people choose, and which do they open and then abandon”. Stable id, assigned once — never the display string, or a copy edit splits one topic into two rows."
        },
        {
          "property": "topic_group",
          "type": "String (Enum)",
          "scope": "Event Property",
          "allowed_values": "dating_me | real_life | opinions",
          "class": "0",
          "why": "Which of the three groups in the browse sheet the topic belongs to. Lets the question be asked at group level when per-topic volume is thin."
        },
        {
          "property": "length_bucket",
          "type": "String (Enum)",
          "scope": "Event Property",
          "allowed_values": "1_40 | 41_80 | 81_120 | 121_160 (enums §19)",
          "class": "0",
          "why": "Bucketed length of a saved prompt answer. Never the text: the answer is user-written free text about themselves. Says whether the floor framing changed what people write."
        },
        {
          "property": "draft_length_bucket",
          "type": "String (Enum)",
          "scope": "Event Property",
          "allowed_values": "0 | 1_40 | 41_80 | 81_120 | 121_160",
          "class": "0",
          "why": "Bucketed length of an abandoned draft on prompt_editor_dismissed. Separates “opened and looked” from “wrote half of it and gave up” — two different problems with two different fixes."
        },
        {
          "property": "had_draft",
          "type": "Boolean",
          "scope": "Event Property",
          "allowed_values": "true | false",
          "class": "0",
          "why": "Whether any text existed when the write sheet was dismissed without saving."
        },
        {
          "property": "selection_index",
          "type": "Integer",
          "scope": "Event Property",
          "allowed_values": "1 upwards",
          "class": "0",
          "why": "1-based count of topic selections in one visit to the prompts step, on prompt_topic_selected. selection_index: 1 is the topic the user reached for FIRST — a different question from which topic they saved. Added 16 Sep 2026."
        },
        {
          "property": "used_count",
          "type": "Integer",
          "scope": "Event Property",
          "allowed_values": "0 to 3",
          "class": "0",
          "why": "How many topics were already used when the browse sheet was opened or cancelled. Carried by prompt_topic_list_opened and prompt_topic_list_dismissed — browsing with nothing written is a different act from browsing for a third prompt."
        },
        {
          "property": "dismiss_method",
          "type": "String (Enum)",
          "scope": "Event Property",
          "allowed_values": "close | backdrop | swipe | system_back (enums §23)",
          "class": "0",
          "why": "How a bottom sheet was closed — the write sheet, the topic sheet, the media prompt list, and every sheet after them. ONE canonical set (§23) since 16 Sep 2026: scrim/back and cancel were three spellings of the same four acts. Cheap to record and it separates a deliberate exit from a misplaced tap on the scrim."
        },
        {
          "property": "is_edit",
          "type": "Boolean",
          "scope": "Event Property",
          "allowed_values": "true | false",
          "class": "0",
          "why": "Whether the editor was opened on an existing prompt rather than an empty slot. An edit does not consume a slot and must not be counted as a new prompt."
        },
        {
          "property": "prompt_count",
          "type": "Integer",
          "scope": "Event Property",
          "allowed_values": "0 to 3",
          "class": "0",
          "why": "How many prompts the user holds after the action. The prompts equivalent of filled_count on photos. Also carried by profile_step_completed on step_id: \"prompts\" (v1.4.1) — that is the answer to how much was written when Continue was pressed, and the step completing does not say it on its own."
        },
        {
