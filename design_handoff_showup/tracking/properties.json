        {
          "property": "hidden_fieldsv1.2",
          "type": "Array[String]",
          "scope": "User Property",
          "allowed_values": "See field_id registry",
          "class": "1",
          "why": "Every field_id the user currently hides, rewritten on every change in both directions. field_display_opted_out answers which fields people choose to hide; it cannot answer how many users hide religion right now, because an un-hide fires nothing and repeated toggling inflates the count. This property is that answer, and it is the value the profile renderer reads anyway."
        },
        {
          "property": "sensitivity_class",
          "type": "Integer",
          "scope": "Required",
          "allowed_values": "0 | 1 | 2 | 3",
          "class": "0",
          "why": "Resolved class stamped on the event at emit time. The pipeline routes on this value and never joins to the registry to make a safety decision."
        },
        {
          "property": "field_registry_version",
          "type": "String",
          "scope": "Required",
          "allowed_values": "SemVer",
          "class": "0",
          "why": "Version of the field_id registry the client resolved against. Lets a historical row be read back with the classification it was collected under."
