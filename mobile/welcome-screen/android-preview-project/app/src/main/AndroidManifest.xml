<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Required now that the app has an API client. Absent, every request fails with a
        SecurityException rather than anything that mentions a missing permission, and it fails on
        a device while working in a unit test — MockWebServer runs in-process and needs nothing.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ShowUpApplication"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShowUp">

        <!--
            adjustResize is required, not optional. The phone-verification screen puts a text field
            above its CTA, and WindowInsets.safeDrawing only reports the keyboard as an inset when
            the window is in resize mode. Without this the CTA can end up underneath the keyboard
            with no way to reach it — and the default (adjustUnspecified) leaves that to the OEM.
        -->
        <!--
            Sentry installs itself from manifest metadata unless told not to. Auto-init reads a DSN
            from here, which would mean committing one and losing the switch, so it is off and
            ShowUpApplication starts the SDK explicitly instead.
        -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ShowUp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
