<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework theme so the project needs no AppCompat dependency. Compose draws everything;
         this only supplies the window background and removes the action bar. -->
    <style name="Theme.ShowUp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#FFFBF7</item>
        <item name="android:navigationBarColor">#FFFBF7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
