<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug overlay. Merged into the main manifest for the debug build only, so the release build
    is unaffected and still refuses cleartext everywhere.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig">

        <!-- Every Check-In frame on a real device, for evidence screenshots (dev/CheckInGalleryActivity.kt).
             Exported so `adb shell am start` can reach it; the debug build only. -->
        <activity
            android:name="com.showup.dev.CheckInGalleryActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ShowUp" />
    </application>
</manifest>
